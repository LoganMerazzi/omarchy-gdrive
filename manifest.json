{
  "schemaVersion": 1,
  "id": "logan.gdrive",
  "name": "Google Drive",
  "version": "1.0.0",
  "author": "logan",
  "license": "MIT",
  "description": "Google Drive via rclone mount: mount toggle, storage usage, folders, and recently opened files.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Google Drive",
    "description": "Mount Google Drive, browse folders, and reopen recent files for editing.",
    "category": "Files",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      }
    ]
  }
}
